{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meelloevhag-star/Blur-con-esteroides/esquema/esquema_datos.json",
  "title": "Registro BioCrete (zona + daño + mezcla + resultado + procedencia)",
  "description": "Una fila = una medición (o condición) trazable. Campos vacíos = no reportado; nunca se imputan.",
  "type": "object",
  "required": ["procedencia_doi_o_url", "procedencia_tipo", "procedencia_ubicacion", "procedencia_verificado",
               "id_grupo", "fuente"],
  "anyOf": [{"required": ["resultado_cierre_pct"]}, {"required": ["resultado_alpha"]},
            {"required": ["dano_tipo"]}, {"required": ["zona_humedad_relativa_pct"]}],
  "properties": {
    "fuente": {"type": "string", "minLength": 2, "description": "Etiqueta corta de la fuente, p. ej. Mousa2022"},
    "id_grupo": {"type": "string", "minLength": 1, "description": "Probeta, fisura, estructura o estudio (para validación agrupada)"},

    "zona_region": {"type": "string"},
    "zona_lat": {"type": "number", "minimum": -90, "maximum": 90},
    "zona_lon": {"type": "number", "minimum": -180, "maximum": 180},
    "zona_distancia_mar_km": {"type": "number", "minimum": 0},
    "zona_humedad_relativa_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "zona_dias_niebla_anio": {"type": "number", "minimum": 0, "maximum": 366},
    "zona_temperatura_media_c": {"type": "number", "minimum": -40, "maximum": 50},
    "zona_cloruros_atmosfericos_mg_m2_dia": {"type": "number", "minimum": 0},
    "zona_clase_exposicion": {"type": "string", "description": "EN 206 (XC, XD, XS1-3, XF, XA) o ISO 9223 (C1-CX)"},
    "zona_ambiente_marino": {"type": "integer", "enum": [0, 1]},
    "zona_ciclos_humectacion": {"type": "integer", "enum": [0, 1]},

    "dano_tipo": {"type": "string", "enum": ["fisura", "corrosion", "eflorescencia", "desprendimiento", "carbonatacion", "otro"]},
    "dano_ancho_fisura_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 5},
    "dano_profundidad_cloruros_mm": {"type": "number", "minimum": 0},
    "dano_profundidad_carbonatacion_mm": {"type": "number", "minimum": 0},
    "dano_edad_estructura_anios": {"type": "number", "minimum": 0},
    "dano_uso": {"type": "string", "enum": ["vivienda", "portuaria", "puente", "pavimento", "tanque", "tunel", "hidraulica", "industrial", "laboratorio", "otro"]},

    "mezcla_a_c": {"type": "number", "minimum": 0.2, "maximum": 0.9},
    "mezcla_cemento": {"type": "string"},
    "mezcla_agregados": {"type": "string"},
    "mezcla_aditivos": {"type": "string"},
    "mezcla_bacteria_especie": {"type": "string"},
    "mezcla_bacteria_dosis": {"type": "string", "description": "Con unidades, p. ej. '1e8 esporas/g cemento'"},
    "mezcla_nivel_proteccion": {"type": "integer", "enum": [0, 1, 2, 3], "description": "0 sin bacterias, 1 directa/comercial, 2 portador, 3 encapsulación"},
    "mezcla_precursor": {"type": "string"},
    "mezcla_lactato_calcio": {"type": "integer", "enum": [0, 1]},
    "mezcla_curado_previo": {"type": "integer", "enum": [0, 1]},
    "mezcla_agente_cristalino": {"type": "integer", "enum": [0, 1]},

    "resultado_edad_dias": {"type": "number", "minimum": 0, "maximum": 2000},
    "resultado_cierre_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "resultado_alpha": {"type": "number", "minimum": 0, "maximum": 1},
    "resultado_alpha_propiedad": {"type": "string", "description": "permeabilidad, absorción capilar, cloruros…"},
    "resultado_protocolo": {"type": "string", "description": "Cómo se midió (microscopía óptica superficial, flujo de agua…)"},
    "resultado_norma": {"type": "string"},

    "procedencia_doi_o_url": {"type": "string", "pattern": "^(10\\.|https?://)"},
    "procedencia_tipo": {"type": "string", "enum": ["articulo", "tesis", "dataset", "laboratorio", "informe", "clima"]},
    "procedencia_ubicacion": {"type": "string", "minLength": 1, "description": "Tabla, figura, hoja o página de origen"},
    "procedencia_verificado": {"type": "string", "enum": ["si", "no"]},
    "procedencia_notas": {"type": "string"}
  },
  "additionalProperties": false
}
